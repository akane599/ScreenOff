<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        android:enabled  whether the shortcut is available
        android:icon  shortcut icon
        android:shortcutId  unique shortcut ID
        android:shortcutShortLabel  short label
        android:shortcutLongLabel  configured long label; the launcher prefers it and falls back to the short label when needed

        android:action    android.intent.action.VIEW
        android:targetClass  target class to open
        android:targetPackage  target application package name
        categories  android.shortcut.conversation
    -->
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/icon"
        android:shortcutId="ScrOff"
        android:shortcutShortLabel="@string/shortcutoff">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.tile.screenoff.ScrOff"
            android:targetPackage="com.tile.screenoff" />
        <categories android:name="android.shortcut.conversation" />
        <capability-binding android:key="actions.intent.CREATE_MESSAGE" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/icon"
        android:shortcutId="MyCollection"
        android:shortcutShortLabel="@string/shortcuton">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.tile.screenoff.ScrOn"
            android:targetPackage="com.tile.screenoff" />
        <categories android:name="android.shortcut.conversation" />
        <capability-binding android:key="actions.intent.CREATE_MESSAGE" />
    </shortcut>
</shortcuts>